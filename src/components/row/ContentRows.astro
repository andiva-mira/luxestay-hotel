---
import FeaturedCardRow from "./FeaturedCardRow.astro";
import AlternatingRow from "./AlternatingRow.astro";
import RoomRow from "./RoomRow.astro";

const { rows } = Astro.props;

const componentMap = {
	featuredCardRow: FeaturedCardRow,
	alternatingRow: AlternatingRow,
	roomRow: RoomRow,
};
---

{
	rows?.map((row: any) => {
		const content = row.content;
		const settings = row.settings;

		if (settings?.properties?.hide) {
			return null;
		}

		const contentType = content?.contentType as keyof typeof componentMap;
		const Component = componentMap[contentType];

		if (!Component) {
			console.warn(`Unknown row type: ${content?.contentType}`);
			return null;
		}

		return <Component content={content} settings={settings} />;
	})
}
