---
const navLinks = [
  { name: "Home", href: "/" },
  { name: "Rooms", href: "/rooms" },
  { name: "Dining", href: "/dining" },
];
---

<nav id="main-nav" class="navbar" aria-label="Main Navigation">
  <div class="nav-container">
    <div class="nav-brand-group">
      <a href="/" class="nav-logo" aria-label="LuxeStay Home">
        Luxe<span class="font-semibold">Stay</span>
      </a>

      <div class="nav-menu">
        {
          navLinks.map((link) => (
            <a href={link.href} class="nav-link">
              {link.name}
            </a>
          ))
        }
      </div>
    </div>

    <div class="nav-actions">
      <div class="nav-phone">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-phone"
          aria-hidden="true"
          ><path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
          ></path></svg
        >
        <span>+1 800 LUXESTAY</span>
      </div>
      <button class="nav-button"> Book Now </button>
    </div>

    <button
      id="menu-toggle"
      class="nav-toggle"
      aria-label="Toggle mobile menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <div id="menu-icon-open">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-menu"
          aria-hidden="true"
          ><line x1="4" x2="20" y1="12" y2="12"></line><line
            x1="4"
            x2="20"
            y1="6"
            y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
        >
      </div>
      <div id="menu-icon-close" class="hidden">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-x"
          aria-hidden="true"
          ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
        >
      </div>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="mobile-overlay"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
  >
    {
      navLinks.map((link) => (
        <a href={link.href} class="mobile-link">
          {link.name}
        </a>
      ))
    }
    <button class="mobile-button"> Check Availability </button>
  </div>
</nav>

<style lang="scss">
  @use "../styles/variables" as *;

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    transition: $transition-slow;
    background-color: transparent;
    padding-top: $space-8;
    padding-bottom: $space-8;

    &.scrolled {
      background-color: rgba($black, 0.9);
      backdrop-filter: blur(8px);
      padding-top: $space-4;
      padding-bottom: $space-4;
    }
  }

  .nav-container {
    @include container;
    @include flex-between;
    color: $white;
  }

  .nav-brand-group {
    display: flex;
    align-items: center;
    gap: $space-12;
  }

  .nav-logo {
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: 0.2em;
    text-transform: uppercase;

    .font-semibold {
      font-weight: 600;
    }
  }

  .nav-menu {
    display: none;
    gap: $space-8;
    white-space: nowrap;

    @media (min-width: $lg) {
      display: flex;
    }
  }

  .nav-link {
    @include uppercase-tracking(11px, 0.3em);
    font-weight: 500;
    opacity: 0.6;
    transition: opacity 0.3s ease;

    &:hover {
      opacity: 1;
    }
  }

  .nav-actions {
    display: none;
    align-items: center;
    gap: $space-8;

    @media (min-width: $lg) {
      display: flex;
    }
  }

  .nav-phone {
    display: flex;
    align-items: center;
    gap: $space-2;
    opacity: 0.6;
    @include uppercase-tracking(11px, 0.1em);
  }

  .nav-button {
    border: 1px solid rgba($white, 0.3);
    border-radius: 9999px;
    padding: $space-2 $space-6;
    @include uppercase-tracking(11px, 0.15em);
    transition: $transition-default;

    &:hover {
      background-color: $white;
      color: $black;
    }
  }

  .nav-toggle {
    display: block;
    color: $white;
    position: relative;
    z-index: 60;
    padding: $space-2 0;

    @media (min-width: $lg) {
      display: none;
    }

    .hidden {
      display: none;
    }
  }

  .mobile-overlay {
    position: fixed;
    inset: 0;
    background-color: $black;
    transform: translateY(-100%);
    transition:
      transform 0.5s cubic-bezier(0.77, 0, 0.175, 1),
      opacity 0.5s ease,
      visibility 0.5s;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: $space-8;
    z-index: 55;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    @media (min-width: $lg) {
      display: none;
    }

    &.open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
  }

  .mobile-link {
    font-size: 2.25rem;
    font-family: $font-serif;
    font-weight: 300;
    transition: all 0.3s ease;

    &:hover {
      font-style: italic;
    }
  }

  .mobile-button {
    margin-top: $space-8;
    border: 1px solid rgba($white, 0.3);
    border-radius: 9999px;
    padding: $space-3 $space-8;
    @include uppercase-tracking(11px, 0.2em);
  }
</style>

<script>
  const nav = document.getElementById("main-nav");
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  // Scroll Detection
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      nav?.classList.add("scrolled");
    } else {
      nav?.classList.remove("scrolled");
    }
  });

  // Mobile Menu Toggle
  function toggleMenu() {
    const isOpen = mobileMenu?.classList.toggle("open");
    menuToggle?.setAttribute("aria-expanded", isOpen ? "true" : "false");
    mobileMenu?.setAttribute("aria-hidden", isOpen ? "false" : "true");

    if (isOpen) {
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    } else {
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      document.body.style.overflow = "auto";
    }
  }

  menuToggle?.addEventListener("click", toggleMenu);
  mobileLinks.forEach((link) => link.addEventListener("click", toggleMenu));
</script>
