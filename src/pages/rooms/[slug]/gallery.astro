---
import BaseLayout from "@/src/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return [
    { params: { slug: 'coastal-panorama' }, props: { 
      name: "Coastal Panorama Suite",
      images: [
        "https://images.unsplash.com/photo-1591088398332-8a77d399c842?auto=format&fit=crop&q=80&w=2574",
        "https://images.unsplash.com/photo-1590490359683-658d3d23f972?auto=format&fit=crop&q=80&w=2574",
        "https://images.unsplash.com/photo-1584132967334-10e028bd69f7?auto=format&fit=crop&q=80&w=2574",
        "https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&fit=crop&q=80&w=2570",
        "https://images.unsplash.com/photo-1537726235470-8504e3beef77?auto=format&fit=crop&q=80&w=2570",
        "https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&q=80&w=2570"
      ]
    }},
    { params: { slug: 'architects-loft' }, props: { 
      name: "Architect's Loft",
      images: [
        "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&q=80&w=2574",
        "https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&q=80&w=2571",
        "https://images.unsplash.com/photo-1493809842364-78817add7ffb?auto=format&fit=crop&q=80&w=2570",
        "https://images.unsplash.com/photo-1484154218962-a197022b5858?auto=format&fit=crop&q=80&w=2574",
        "https://images.unsplash.com/photo-1499916078039-922301b0eb9b?auto=format&fit=crop&q=80&w=2576",
        "https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&fit=crop&q=80&w=2567"
      ]
    }},
    { params: { slug: 'cliffside-cabin' }, props: { 
      name: "Cliffside Cabin",
      images: [
        "https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&q=80&w=2574",
        "https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&q=80&w=2670",
        "https://images.unsplash.com/photo-1449156001533-82ff4268e4ba?auto=format&fit=crop&q=80&w=2670",
        "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&q=80&w=2670",
        "https://images.unsplash.com/photo-1518780664697-55e3ad937233?auto=format&fit=crop&q=80&w=1200",
        "https://images.unsplash.com/photo-1472214103451-9374bd1c798e?auto=format&fit=crop&q=80&w=2670"
      ]
    }},
    { params: { slug: 'presidential-wing' }, props: { 
      name: "The Presidential Wing",
      images: [
        "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&q=80&w=2570",
        "https://images.unsplash.com/photo-1551882547-ff43c69e5cf2?auto=format&fit=crop&q=80&w=2670",
        "https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&q=80&w=2670",
        "https://images.unsplash.com/photo-1560185007-cde436f6a4d0?auto=format&fit=crop&q=80&w=2670",
        "https://images.unsplash.com/photo-1549294413-26f195af0fdc?auto=format&fit=crop&q=80&w=2670",
        "https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&q=80&w=2670"
      ]
    }},
  ];
}

const { slug } = Astro.params;
const { name, images } = Astro.props;
---

<BaseLayout title={`${name} Gallery`}>
  <section class="gallery-section">
    <div class="gallery-container">
      <div class="gallery-header">
        <a href={`/rooms/${slug}`} class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="back-icon"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          <span>Return to Suite</span>
        </a>
        <h1 class="gallery-title serif italic">{name} <span class="gallery-title-fade">Gallery</span></h1>
      </div>

      <div class="gallery-grid">
        {images.map((image, i) => (
          <div class={`gallery-item ${i === 0 ? 'featured' : ''}`}>
            <img 
              src={image} 
              alt={`${name} perspective ${i + 1}`} 
              class="gallery-img"
              referrerpolicy="no-referrer"
            />
            <div class="img-overlay"></div>
            <div class="zoom-indicator">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="zoom-icon"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" x2="14" y1="3" y2="10"/><line x1="3" x2="10" y1="21" y2="14"/></svg>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Navigation for other views -->
  <section class="gallery-footer">
    <div class="footer-container">
      <h3 class="footer-title serif italic">Immerse yourself in our coastal philosophy.</h3>
      <div class="footer-actions">
        <button class="text-link">Download Viewbook</button>
        <button class="text-link">Virtual Tour</button>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use "../../../styles/variables" as *;

  .gallery-section {
    padding-top: $space-32;
    padding-bottom: $space-24;
    padding-left: $space-6;
    padding-right: $space-6;
    background-color: $black;

    @media (min-width: $md) {
      padding-left: $space-12;
      padding-right: $space-12;
    }
  }

  .gallery-container {
    @include container;
  }

  .gallery-header {
    margin-bottom: $space-16;
    display: flex;
    flex-direction: column;
    gap: $space-6;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: $space-3;
    @include uppercase-tracking(10px, 0.3em);
    font-weight: 600;
    opacity: 0.4;
    transition: opacity 0.3s ease;
    text-decoration: none;
    color: inherit;

    &:hover {
      opacity: 1;
    }
  }

  .gallery-title {
    font-size: clamp(2rem, 6vw, 3.75rem);
    font-weight: 300;
  }

  .gallery-title-fade {
    font-style: normal;
    opacity: 0.4;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: $space-8;

    @media (min-width: $md) {
      grid-template-columns: repeat(2, 1fr);
      gap: $space-12;
    }

    @media (min-width: $lg) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    background-color: #18181b;
    aspect-ratio: 1 / 1;

    &.featured {
      @media (min-width: $md) {
        grid-column: span 2;
        grid-row: span 2;
      }
    }
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 2s ease, opacity 0.5s ease;
    opacity: 0.8;

    .gallery-item:hover & {
      transform: scale(1.05);
      opacity: 1;
    }
  }

  .img-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba($black, 0.2);
    transition: background-color 0.5s ease;

    .gallery-item:hover & {
      background-color: transparent;
    }
  }

  .zoom-indicator {
    position: absolute;
    bottom: $space-6;
    right: $space-6;
    opacity: 0;
    transition: opacity 0.5s ease;

    .gallery-item:hover & {
      opacity: 1;
    }
  }

  .zoom-icon {
    color: $white;
    filter: drop-shadow(0 4px 6px rgba($black, 0.5));
  }

  .gallery-footer {
    padding: $space-24 $space-6;
    border-top: 1px solid rgba($white, 0.05);

    @media (min-width: $md) {
      padding-left: $space-12;
      padding-right: $space-12;
    }
  }

  .footer-container {
    max-width: 56rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: $space-8;
  }

  .footer-title {
    font-size: 1.5rem;
    opacity: 0.6;
  }

  .footer-actions {
    display: flex;
    gap: $space-12;
    justify-content: center;
  }

  .text-link {
    @include uppercase-tracking(11px, 0.2em);
    font-weight: 600;
    border-bottom: 1px solid rgba($white, 0.2);
    padding-bottom: $space-1;
    transition: border-color 0.3s ease;

    &:hover {
      border-color: $white;
    }
  }
</style>
